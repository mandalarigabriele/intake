{
  "name": "@intake/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file=../../.env src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "capture": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file=../../.env scripts/capture-mcp.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@intake/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
