                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unit of the quantity, e.g. \"g\", \"ml\", \"piece\""
                        }
                      },
                      "required": [
                        "name",
                        "quantity",
                        "unit"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "macros": {
                    "type": "object",
                    "properties": {
                      "kcal": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Energy in kcal"
                      },
                      "protein": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Protein in grams"
                      },
                      "carbs": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Carbohydrates in grams"
                      },
                      "fat": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Total fat in grams"
                      },
                      "fiber": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Fiber in grams"
                      },
                      "sugar": {
                        "description": "Total sugar in grams. Must be given together with addedSugar.",
                        "type": "number",
                        "minimum": 0
                      },
                      "addedSugar": {
                        "description": "Added sugar in grams, part of sugar (never more than sugar). Must be given together with sugar.",
                        "type": "number",
                        "minimum": 0
                      },
                      "saturatedFat": {
                        "description": "Saturated fat in grams, part of fat (never more than fat)",
                        "type": "number",
                        "minimum": 0
                      },
                      "sodiumMg": {
                        "description": "Sodium in milligrams (not salt: 1 g of salt is about 400 mg of sodium)",
