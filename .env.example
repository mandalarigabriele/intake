# Copy to .env on the server and fill in the values. Never commit .env.

# Public URL of the app, used for OAuth redirect URLs (no trailing slash).
# Use http://localhost:3000 for local development.
PUBLIC_BASE_URL=

# HTTP port inside the container
PORT=3000

# Directory for the SQLite database and encrypted tokens (use ./data for local development)
DATA_DIR=/data

# Google sign-in (OAuth client of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed to sign in
OWNER_EMAIL=

# Random secret used to sign session cookies (at least 32 characters)
SESSION_SECRET=

# Random key used to encrypt the Nutrition MCP refresh token (at least 32 characters)
TOKEN_ENCRYPTION_KEY=

# Nutrition MCP server endpoint
NUTRITION_MCP_URL=https://nutrition-mcp.com/mcp
